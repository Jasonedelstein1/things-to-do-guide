---
const { place } = Astro.props; // the rmnp-reservations entry
---

<div class="modal-overlay" id="rmnp-modal" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="rmnp-modal-title" tabindex="-1">
    <div class="modal-head">
      <h2 id="rmnp-modal-title">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 20h18L14.5 7l-3 5-2-3L3 20z"/></svg>
        RMNP Permits &amp; Timed Entry
      </h2>
      <button type="button" class="modal-close" data-close-modal aria-label="Close permit info">&times;</button>
    </div>
    <p class="modal-lede">
      Heading into Rocky Mountain National Park? Here's the verified 2026 timed-entry rundown —
      everything you need to plan ahead.
    </p>
    <ul class="modal-list">
      {place.notes.map((note) => <li>{note}</li>)}
    </ul>
    {place.verified && (
      <p class="modal-verified">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg>
        {place.verified}
      </p>
    )}
    <div class="modal-actions">
      <a class="modal-btn" href="https://www.recreation.gov/timed-entry/10086910" target="_blank" rel="noopener noreferrer">Reserve on Recreation.gov ↗</a>
      <button type="button" class="modal-btn-ghost" data-close-modal>Got it</button>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(28, 26, 22, 0.55);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0;
    animation: modal-fade 0.18s ease;
  }
  .modal-overlay[hidden] { display: none; }

  @media (min-width: 640px) {
    .modal-overlay { align-items: center; padding: 24px; }
  }

  .modal {
    background: var(--paper);
    width: 100%;
    max-width: 600px;
    max-height: 88vh;
    overflow-y: auto;
    border-radius: 18px 18px 0 0;
    padding: 20px;
    box-shadow: var(--shadow-lg);
    animation: modal-rise 0.22s ease;
    -webkit-overflow-scrolling: touch;
  }
  @media (min-width: 640px) {
    .modal { border-radius: 18px; padding: 24px 26px; }
  }

  .modal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    position: sticky;
    top: -20px;
    background: var(--paper);
    padding-top: 2px;
    margin: -2px 0 6px;
  }
  .modal-head h2 {
    margin: 0;
    font-size: 1.35rem;
    color: var(--pine-deep);
    display: flex;
    align-items: center;
    gap: 0.4em;
  }
  .modal-head h2 .icon { width: 1.1em; height: 1.1em; color: var(--terracotta); }
  .modal-close {
    flex: none;
    font-size: 1.8rem;
    line-height: 1;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--paper-2);
    color: var(--ink-soft);
    cursor: pointer;
    transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease),
                transform var(--t-fast) var(--ease);
  }
  .modal-close:hover { background: var(--line); color: var(--ink); }
  .modal-close:active { transform: scale(0.94); }

  .modal-lede { margin: 0 0 14px; color: var(--ink); }

  .modal-list {
    margin: 0;
    padding-left: 1.15em;
    display: grid;
    gap: 9px;
  }
  .modal-list li { line-height: 1.5; }
  .modal-list li::marker { color: var(--pine); }

  .modal-verified {
    margin: 14px 0 0;
    font-size: 0.84rem;
    color: var(--ink-soft);
    font-style: italic;
    display: flex;
    align-items: flex-start;
    gap: 0.45em;
  }
  .modal-verified .icon { width: 1.05em; height: 1.05em; margin-top: 0.18em; color: var(--pine); flex: none; }

  .modal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
    position: sticky;
    bottom: -20px;
    background: var(--paper);
    padding: 12px 0 2px;
  }
  .modal-btn {
    flex: 1;
    min-width: 200px;
    text-align: center;
    background: var(--pine);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    padding: 12px 18px;
    border-radius: 999px;
    min-height: 44px;
    box-shadow: var(--shadow-xs);
    transition: background var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease),
                transform var(--t-fast) var(--ease);
  }
  .modal-btn:hover { background: var(--pine-deep); box-shadow: var(--shadow-sm); }
  .modal-btn:active { transform: translateY(1px); }
  .modal-btn-ghost {
    font: inherit;
    font-weight: 600;
    background: var(--paper-2);
    border: 1px solid var(--line-strong);
    color: var(--ink);
    border-radius: 999px;
    padding: 12px 18px;
    min-height: 44px;
    cursor: pointer;
    transition: background var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .modal-btn-ghost:hover { background: var(--line); border-color: var(--pine); }

  @keyframes modal-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes modal-rise { from { transform: translateY(16px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

  :global(body.modal-open) { overflow: hidden; }
</style>
