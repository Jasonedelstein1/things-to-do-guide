---
const { place } = Astro.props; // the rmnp-reservations entry
---

<div class="modal-overlay" id="rmnp-modal" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="rmnp-modal-title" tabindex="-1">
    <div class="modal-head">
      <h2 id="rmnp-modal-title">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 20h18L14.5 7l-3 5-2-3L3 20z"/></svg>
        RMNP Permits &amp; Timed Entry
      </h2>
      <button type="button" class="modal-close" data-close-modal aria-label="Close permit info">&times;</button>
    </div>
    <p class="modal-lede">
      Heading into Rocky Mountain National Park? Here's the verified 2026 timed-entry rundown —
      everything you need to plan ahead.
    </p>
    <ul class="modal-list">
      {place.notes.map((note) => <li>{note}</li>)}
    </ul>
    {place.verified && (
      <p class="modal-verified">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg>
        {place.verified}
      </p>
    )}
    <div class="modal-actions">
      <a class="modal-btn" href="https://www.recreation.gov/timed-entry/10086910" target="_blank" rel="noopener noreferrer">Reserve on Recreation.gov ↗</a>
      <button type="button" class="modal-btn-ghost" data-close-modal>Got it</button>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(28, 22, 14, 0.62);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0;
    animation: modal-fade 0.18s ease;
  }
  .modal-overlay[hidden] { display: none; }

  @media (min-width: 640px) {
    .modal-overlay { align-items: center; padding: 24px; }
  }

  /* Permit lightbox = an official stamped notice */
  .modal {
    background: var(--paper);
    width: 100%;
    max-width: 600px;
    max-height: 88vh;
    overflow-y: auto;
    border: 3px solid var(--ink);
    border-top: 6px solid var(--terracotta);
    border-radius: 12px 12px 0 0;
    padding: 20px;
    box-shadow: var(--shadow-lg);
    animation: modal-rise 0.22s ease;
    -webkit-overflow-scrolling: touch;
  }
  @media (min-width: 640px) {
    .modal { border-radius: 12px; border-top-width: 6px; padding: 24px 26px; }
  }

  .modal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    position: sticky;
    top: -20px;
    background: var(--paper);
    padding-top: 2px;
    margin: -2px 0 6px;
  }
  .modal-head h2 {
    margin: 0;
    font-size: 1.4rem;
    color: var(--pine-deep);
    display: flex;
    align-items: center;
    gap: 0.4em;
    letter-spacing: 0.03em;
  }
  .modal-head h2 .icon { width: 1.1em; height: 1.1em; color: var(--terracotta); }
  .modal-close {
    flex: none;
    font-size: 1.7rem;
    line-height: 1;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-xs);
    border: 2px solid var(--ink);
    background: var(--paper-2);
    color: var(--ink);
    cursor: pointer;
    transition: background var(--t-fast) var(--ease), transform var(--t-fast) var(--ease);
  }
  .modal-close:hover { background: var(--paper-3); }
  .modal-close:active { transform: scale(0.94); }

  .modal-lede { margin: 0 0 14px; color: var(--ink); }

  .modal-list {
    margin: 0;
    padding-left: 1.15em;
    display: grid;
    gap: 10px;
  }
  .modal-list li { line-height: 1.55; }
  .modal-list li::marker { color: var(--terracotta); }

  .modal-verified {
    margin: 14px 0 0;
    font-size: 0.84rem;
    color: var(--ink-soft);
    font-style: italic;
    display: flex;
    align-items: flex-start;
    gap: 0.45em;
  }
  .modal-verified .icon { width: 1.05em; height: 1.05em; margin-top: 0.18em; color: var(--pine); flex: none; }

  .modal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
    position: sticky;
    bottom: -20px;
    background: var(--paper);
    padding: 12px 0 2px;
  }
  .modal-btn, .modal-btn-ghost {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    min-height: 46px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--t-fast) var(--ease), transform var(--t-fast) var(--ease),
                box-shadow var(--t-fast) var(--ease);
  }
  .modal-btn {
    flex: 1;
    min-width: 200px;
    text-align: center;
    background: var(--terracotta);
    color: #fff;
    text-decoration: none;
    padding: 13px 18px;
    border: 2px solid var(--terracotta-deep);
    box-shadow: 3px 3px 0 rgba(42,32,23,0.22);
  }
  .modal-btn:hover { background: var(--terracotta-deep); }
  .modal-btn:active { transform: translate(2px, 2px); box-shadow: 0 0 0 rgba(42,32,23,0.22); }
  .modal-btn-ghost {
    background: var(--paper-2);
    border: 2px solid var(--ink);
    color: var(--ink);
    padding: 13px 18px;
  }
  .modal-btn-ghost:hover { background: var(--paper-3); }
  .modal-btn-ghost:active { transform: translateY(1px); }

  @keyframes modal-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes modal-rise { from { transform: translateY(16px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

  :global(body.modal-open) { overflow: hidden; }
</style>
