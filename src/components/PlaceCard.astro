---
import data from '../data/places.json';
import { effectiveRating, searchText } from '../lib/ratings.js';

const scale = data.meta.ratingScale;
const { place } = Astro.props;

const isBeyond = place.rating == null;
const r = effectiveRating(place);
const label = isBeyond ? 'Other' : (scale[String(r)]?.label ?? '');
const hasCoords = place.lat !== null && place.lng !== null;

// Dual rating: keep Old Fall River's drive/ride phrasing; generic for the rest.
let dualLabel = null;
if (place.ratingJason != null) {
  dualLabel = place.id === 'old-fall-river-road'
    ? `Drive it: Andrea (${place.rating}) · Ride it: Jason (${place.ratingJason})`
    : `Andrea (${place.rating}) → Jason (${place.ratingJason})`;
}

// Google Maps directions from the user's current location to this spot.
const dirUrl = hasCoords
  ? `https://www.google.com/maps/dir/?api=1&destination=${place.lat},${place.lng}&travelmode=driving`
  : null;

// A reservation that depends on RMNP timed-entry links to the banner.
const reservation = place.reservation;
const linksToRmnp =
  !!reservation && /timed-entry/i.test(reservation) && /RMNP/i.test(reservation);

// Subtle secondary name line.
let aka = null;
if (place.nickname) aka = `aka "${place.nickname}"`;
else if (place.formerName) aka = `formerly listed as "${place.formerName}"`;

const search = searchText(place);
---

<article
  class="card"
  id={`card-${place.id}`}
  data-id={place.id}
  data-category={place.category}
  data-rating={isBeyond ? '' : r}
  data-beyond={String(isBeyond)}
  data-allaccess={String(place.allAccess)}
  data-haslatlng={String(hasCoords)}
  data-search={search}
  tabindex="-1"
>
  <div class="card-head">
    <span class="badge card-seal" data-rating={isBeyond ? 'beyond' : r}>
      <span class="badge-num" aria-hidden="true">
        {isBeyond
          ? <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3l1.8 5.5L19.5 10l-5.7 1.5L12 17l-1.8-5.5L4.5 10l5.7-1.5L12 3z"/></svg>
          : r}
      </span>
      <span class="seal-label">{label}</span>
    </span>
    <div class="card-titles">
      <h3 class="card-name">{place.name}</h3>
      {aka && <p class="card-aka">{aka}</p>}
    </div>
  </div>

  <p class="card-meta">
    <span class="meta-cat">{place.category}</span>
    <span class="meta-dot" aria-hidden="true">·</span>
    <span class="meta-town">{place.town}</span>
    {place.driveFromLyons && (
      <>
        <span class="meta-dot" aria-hidden="true">·</span>
        <span class="meta-drive">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 13l1.6-4.2A2 2 0 0 1 8.5 7.5h7a2 2 0 0 1 1.9 1.3L19 13"/><path d="M3 17h18v-3.2a1.8 1.8 0 0 0-1-1.6l-1-.5H5l-1 .5a1.8 1.8 0 0 0-1 1.6V17z"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/></svg>
          {place.driveFromLyons} from Lyons
        </span>
      </>
    )}
  </p>

  {place.address && (
    <p class="card-address">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21s-6.5-5.6-6.5-10.5A6.5 6.5 0 0 1 18.5 10.5C18.5 15.4 12 21 12 21z"/><circle cx="12" cy="10.5" r="2.4"/></svg>
      {place.address}
    </p>
  )}

  <div class="card-tags">
    {place.allAccess && (
      <span class="badge-all-access" title="Both Andrea & Jason approve">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 18.2 6.1 21.3l1.2-6.6L2.5 9.5l6.6-.9L12 2.5z"/></svg>
        All-access
      </span>
    )}
    {dualLabel && (
      <span class="dual-rating">{dualLabel}</span>
    )}
    {place.ratingRange && !place.ratingJason && (
      <span class="range-rating">
        Spans {place.ratingRange[0]}–{place.ratingRange[1]} · filtered at {place.rating}
      </span>
    )}
  </div>

  {reservation && (
    <p class={`card-reservation${linksToRmnp ? ' is-rmnp' : ''}`}>
      <svg class="icon res-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2 2 2 0 0 0 0 4 2 2 0 0 1-2 2H6a2 2 0 0 1-2-2 2 2 0 0 0 0-4z"/><path d="M10 6v2"/><path d="M10 11v2"/><path d="M10 16v2"/></svg>
      <span><strong>Reservation:</strong> {reservation}{' '}
        {linksToRmnp && (
          <button type="button" class="res-flag" data-open-rmnp>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 20h18L14.5 7l-3 5-2-3L3 20z"/><path d="M11.5 12l1-2"/></svg>
            RMNP permit info
          </button>
        )}
      </span>
    </p>
  )}

  <ul class="notes">
    {place.notes.map((note) => <li>{note}</li>)}
  </ul>

  {place.verified && (
    <details class="verified">
      <summary>Verified facts <span class="muted">(re-check before you go)</span></summary>
      <p>{place.verified}</p>
    </details>
  )}

  {hasCoords && (
    <div class="card-actions">
      <button type="button" class="btn-show-map" data-show-map={place.id}>
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21s-6.5-5.6-6.5-10.5A6.5 6.5 0 0 1 18.5 10.5C18.5 15.4 12 21 12 21z"/><circle cx="12" cy="10.5" r="2.4"/></svg>
        Show on map
      </button>
      <a class="btn-directions" href={dirUrl} target="_blank" rel="noopener noreferrer">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5l9.5 19-9.5-4-9.5 4 9.5-19z"/></svg>
        Get directions
      </a>
    </div>
  )}
</article>

<style>
  /* ===== Card = a vintage park pass / stamped ticket ===== */
  .card {
    position: relative;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    padding: 18px 18px 16px;
    box-shadow: 4px 4px 0 rgba(42, 32, 23, 0.13);
    scroll-margin-top: calc(var(--header-h) + 16px);
    transition: box-shadow var(--t-med) var(--ease), transform var(--t-med) var(--ease);
  }
  /* Inner "perforation" hairline — the ticket double-rule */
  .card::before {
    content: "";
    position: absolute;
    inset: 5px;
    border: 1.5px dashed var(--line-strong);
    border-radius: calc(var(--radius) - 4px);
    pointer-events: none;
    opacity: 0.7;
  }
  .card > * { position: relative; }
  .card:hover {
    box-shadow: 6px 6px 0 rgba(42, 32, 23, 0.16);
    transform: translate(-2px, -2px);
  }
  .card.is-flash {
    box-shadow: 0 0 0 3px var(--gold), 6px 6px 0 rgba(42, 32, 23, 0.2);
  }

  .card-head {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: "title seal";
    align-items: start;
    gap: 10px 12px;
  }
  .card-titles { grid-area: title; min-width: 0; }
  .card-name {
    font-size: 1.22rem;
    margin: 0;
    color: var(--ink);
    line-height: 1.08;
  }
  .card-aka {
    margin: 3px 0 0;
    font-size: 0.82rem;
    color: var(--ink-soft);
    font-style: italic;
  }

  /* The rating seal, anchored top-right like a stamp; numeral over label */
  .card-seal {
    grid-area: seal;
    flex-direction: column;
    align-items: center;
    gap: 0.25em;
    text-align: center;
  }
  .card-seal .badge-num {
    width: 2.5em;
    height: 2.5em;
    font-size: 1.1em;
  }
  .card-seal .badge-num svg { width: 1.25em; height: 1.25em; fill: #fff; stroke: none; }
  .card-seal .seal-label {
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    max-width: 7.5em;
    line-height: 1.1;
  }

  .card-meta {
    margin: 10px 0 0;
    font-size: 0.84rem;
    color: var(--ink-soft);
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }
  .meta-cat {
    font-weight: 600;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--pine);
  }
  .meta-dot { color: var(--line-strong); }
  .meta-drive { display: inline-flex; align-items: center; gap: 0.35em; }
  .meta-drive .icon { width: 1em; height: 1em; color: var(--ink-soft); }

  .card-address {
    margin: 8px 0 0;
    font-size: 0.8rem;
    color: var(--ink-soft);
    display: flex;
    align-items: flex-start;
    gap: 0.4em;
  }
  .card-address .icon { width: 1em; height: 1em; margin-top: 0.18em; color: var(--terracotta); }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-top: 11px;
  }
  .card-tags:empty { display: none; }

  .dual-rating, .range-rating {
    font-family: var(--font-display);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    background: var(--paper-2);
    border: 1.5px dashed var(--line-strong);
    border-radius: var(--radius-xs);
    padding: 0.3em 0.7em 0.22em;
  }
  .dual-rating strong { color: var(--ink); }

  /* Reservation = a stamped notice strip */
  .card-reservation {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    margin: 13px 0 0;
    padding: 10px 12px;
    font-size: 0.88rem;
    background: rgba(203, 148, 51, 0.12);
    border: 1.5px solid var(--gold);
    border-left-width: 5px;
    border-radius: var(--radius-sm);
  }
  .card-reservation.is-rmnp {
    background: rgba(191, 90, 60, 0.10);
    border-color: var(--terracotta);
  }
  .res-icon { width: 1.1em; height: 1.1em; margin-top: 0.12em; color: var(--gold-deep); }
  .card-reservation.is-rmnp .res-icon { color: var(--terracotta); }
  .res-flag {
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: #fff;
    background: var(--terracotta);
    border: 2px solid var(--terracotta-deep);
    border-radius: var(--radius-xs);
    padding: 5px 12px;
    margin-top: 5px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    transition: filter var(--t-fast) var(--ease), transform var(--t-fast) var(--ease);
  }
  .res-flag .icon { width: 1.05em; height: 1.05em; }
  .res-flag:hover { filter: brightness(0.95); }
  .res-flag:active { transform: translateY(1px); }

  .notes {
    margin: 13px 0 0;
    padding-left: 1.1em;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .notes li { line-height: 1.55; }
  .notes li::marker { color: var(--terracotta); }

  .verified {
    margin-top: 13px;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .verified summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.82rem;
    color: var(--pine);
  }
  .verified summary:hover { color: var(--terracotta); }
  .verified .muted { font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--ink-soft); font-family: var(--font-serif); font-style: italic; }
  .verified p { margin: 8px 0 0; }

  .card-actions {
    margin-top: 15px;
    padding-top: 14px;
    border-top: 1.5px dashed var(--line-strong);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  /* Signage-style action buttons */
  .btn-directions, .btn-show-map {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--radius-sm);
    padding: 9px 15px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    cursor: pointer;
    text-decoration: none;
    transition: background var(--t-fast) var(--ease), transform var(--t-fast) var(--ease),
                box-shadow var(--t-fast) var(--ease);
  }
  .btn-directions .icon, .btn-show-map .icon { width: 1.1em; height: 1.1em; }
  .btn-directions {
    color: #fff;
    background: var(--pine);
    border: 2px solid var(--pine-deep);
    box-shadow: 2px 2px 0 rgba(42, 32, 23, 0.2);
  }
  .btn-directions:hover { background: var(--pine-deep); }
  .btn-directions:active { transform: translate(2px, 2px); box-shadow: 0 0 0 rgba(42, 32, 23, 0.2); }
  .btn-show-map {
    color: var(--pine-deep);
    background: var(--paper);
    border: 2px solid var(--pine);
    box-shadow: 2px 2px 0 rgba(42, 32, 23, 0.16);
  }
  .btn-show-map:hover { background: var(--paper-2); }
  .btn-show-map:active { transform: translate(2px, 2px); box-shadow: 0 0 0 rgba(42, 32, 23, 0.16); }
</style>
