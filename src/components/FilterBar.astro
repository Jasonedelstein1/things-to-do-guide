---
const { scale, categories } = Astro.props;

const catLabels = {
  'Attraction/Activity': 'Attractions',
  'Restaurant/Food': 'Food',
  'Itinerary Idea': 'Itinerary',
  'Other Activities': 'Other',
};

// Default slider position is 5 (Full Jason → show everything).
const defaultLevel = 5;
const defaultLabel = scale[String(defaultLevel)].label;
const defaultMeaning = scale[String(defaultLevel)].meaning;
---

<form class="filters" id="filters" role="search" aria-label="Filter activities">
  <!-- Primary control: the Andrea↔Jason slider (always visible, compact) -->
  <div class="slider-block">
    <div class="slider-toprow">
      <label class="slider-label" for="intensity">How adventurous today?</label>
      <span class="readout-badge badge" data-rating={defaultLevel} id="readout-badge">
        <span class="badge-num" aria-hidden="true" id="readout-num">{defaultLevel}</span>
        <span class="readout-label-text" id="readout-label">{defaultLabel}</span>
      </span>
    </div>

    <div class="slider-rail">
      <span class="end end-andrea" aria-hidden="true">Andrea</span>
      <input
        type="range"
        id="intensity"
        name="intensity"
        min="1"
        max="5"
        step="1"
        value={defaultLevel}
        aria-label="Maximum intensity, Andrea (1) to Jason (5)"
        aria-valuetext={`${defaultLevel} of 5 — ${defaultLabel}`}
        list="intensity-ticks"
      />
      <span class="end end-jason" aria-hidden="true">Jason</span>
    </div>
    <datalist id="intensity-ticks">
      <option value="1"></option>
      <option value="2"></option>
      <option value="3"></option>
      <option value="4"></option>
      <option value="5"></option>
    </datalist>

    <p class="slider-meaning" id="readout-meaning">{defaultMeaning}</p>
  </div>

  <!-- Compact always-visible row: filters toggle (mobile), count, view switch -->
  <div class="bar-row">
    <button type="button" class="filters-toggle" id="filters-toggle" aria-expanded="false" aria-controls="secondary">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 6h16"/><path d="M7 12h10"/><path d="M10 18h4"/></svg>
      <span>Filters</span>
    </button>

    <p class="results-count" aria-live="polite"><span id="count-shown">—</span> of <span id="count-total">—</span></p>

    <div class="view-toggle" role="group" aria-label="Switch between map and list">
      <button type="button" class="vbtn is-active" data-view="list" aria-pressed="true">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>
        <span>List</span>
      </button>
      <button type="button" class="vbtn" data-view="map" aria-pressed="false">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"/><path d="M9 4v14"/><path d="M15 6v14"/></svg>
        <span>Map</span>
      </button>
    </div>
  </div>

  <!-- Secondary filters: collapsed on mobile (toggle above), always shown on desktop -->
  <div class="secondary" id="secondary">
    <div class="chips" role="group" aria-label="Filter by category">
      <button type="button" class="chip is-active" data-category="all" aria-pressed="true">All</button>
      {categories.map((cat) => (
        <button type="button" class="chip" data-category={cat} aria-pressed="false">
          {catLabels[cat] ?? cat}
        </button>
      ))}
    </div>

    <div class="secondary-row">
      <label class="switch">
        <input type="checkbox" id="allaccess-toggle" />
        <span class="switch-track" aria-hidden="true"><span class="switch-knob"></span></span>
        <span class="switch-text">
          <svg class="icon icon-star" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 18.2 6.1 21.3l1.2-6.6L2.5 9.5l6.6-.9L12 2.5z"/></svg>
          All-access only
        </span>
      </label>

      <label class="bypass">
        <input type="checkbox" id="bypass-toggle" />
        <span>Show everything</span>
      </label>

      <button type="button" class="btn-reset" id="reset-filters">Reset</button>
    </div>

    <div class="search">
      <svg class="icon search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <input type="search" id="search" placeholder="Search places &amp; notes…" aria-label="Search places and notes" autocomplete="off" />
    </div>
  </div>
</form>

<style>
  .filters {
    display: grid;
    gap: 10px;
  }

  /* ---- Slider (primary): a "trail-meter" panel ---- */
  .slider-block {
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    padding: 12px 14px 13px;
    box-shadow: 3px 3px 0 rgba(42, 32, 23, 0.12);
  }
  .slider-toprow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 9px;
  }
  .slider-label {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--pine-deep);
  }
  .readout-badge { font-size: 0.82rem; }
  .readout-label-text { font-size: 0.92em; }

  .slider-rail {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .end {
    font-weight: 600;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    flex: none;
    width: 3.6em;
    text-align: center;
  }
  .end-andrea { color: var(--r1); }
  .end-jason { color: var(--r5); }

  input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    flex: 1;
    height: 12px;
    border-radius: 3px;
    background: var(--rating-gradient);
    border: 1.5px solid var(--ink);
    cursor: pointer;
    outline-offset: 6px;
  }
  /* Chunky "map-marker" thumb */
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--paper);
    border: 3px solid var(--ink);
    box-shadow: 0 2px 0 rgba(42, 32, 23, 0.28);
    cursor: grab;
    margin-top: -1px;
    transition: transform var(--t-fast) var(--ease);
  }
  input[type="range"]:hover::-webkit-slider-thumb { transform: scale(1.06); }
  input[type="range"]::-webkit-slider-thumb:active { cursor: grabbing; transform: scale(1.1); }
  input[type="range"]::-moz-range-thumb {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--paper);
    border: 3px solid var(--ink);
    box-shadow: 0 2px 0 rgba(42, 32, 23, 0.28);
    cursor: grab;
  }
  input[type="range"]::-moz-range-track {
    height: 12px;
    border-radius: 3px;
    background: var(--rating-gradient);
    border: 1.5px solid var(--ink);
  }

  .slider-meaning {
    margin: 10px 0 0;
    font-size: 0.86rem;
    color: var(--ink-soft);
    min-height: 1.2em;
  }
  .slider-block.is-bypassed .slider-rail,
  .slider-block.is-bypassed .readout-badge,
  .slider-block.is-bypassed .slider-meaning {
    opacity: 0.4;
  }

  /* ---- Compact action row ---- */
  .bar-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  /* Shared chunky "signage" button base */
  .filters-toggle,
  .chip,
  .vbtn,
  .btn-reset {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .filters-toggle {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--ink);
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: var(--radius-sm);
    padding: 8px 14px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    cursor: pointer;
    box-shadow: 2px 2px 0 rgba(42, 32, 23, 0.18);
    transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease),
                box-shadow var(--t-fast) var(--ease), transform var(--t-fast) var(--ease);
  }
  .filters-toggle .icon { width: 1.05em; height: 1.05em; }
  .filters-toggle:hover { background: var(--paper-2); }
  .filters-toggle:active { transform: translate(2px, 2px); box-shadow: 0 0 0 rgba(42, 32, 23, 0.18); }
  .filters-toggle[aria-expanded="true"] {
    background: var(--pine);
    color: #fff;
  }
  .results-count {
    margin: 0;
    font-size: 0.78rem;
    color: var(--ink-soft);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .view-toggle {
    margin-left: auto;
    display: inline-flex;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: var(--radius-sm);
    padding: 3px;
    gap: 3px;
    box-shadow: 2px 2px 0 rgba(42, 32, 23, 0.18);
  }
  .vbtn {
    font-size: 0.82rem;
    font-weight: 600;
    border: none;
    background: none;
    color: var(--ink);
    border-radius: var(--radius-xs);
    padding: 7px 13px;
    min-height: 38px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  .vbtn .icon { width: 1em; height: 1em; }
  .vbtn:hover { background: var(--paper-2); }
  .vbtn.is-active { background: var(--pine); color: #fff; }
  .vbtn.is-active:hover { background: var(--pine-deep); }

  /* ---- Secondary filters (collapsible on mobile) ---- */
  .secondary { display: none; }
  .secondary.is-open {
    display: grid;
    gap: 11px;
    padding: 13px;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: 3px 3px 0 rgba(42, 32, 23, 0.12);
    animation: filt-in var(--t-med) var(--ease);
  }
  @keyframes filt-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }

  .chips { display: flex; flex-wrap: wrap; gap: 7px; }
  /* Chips = chunky stamped tags */
  .chip {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink);
    background: var(--paper);
    border: 2px solid var(--line-strong);
    border-radius: var(--radius-sm);
    padding: 8px 14px;
    min-height: 44px;
    cursor: pointer;
    transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease),
                border-color var(--t-fast) var(--ease), transform var(--t-fast) var(--ease);
  }
  .chip:hover { border-color: var(--ink); background: var(--paper-2); }
  .chip:active { transform: translateY(1px); }
  .chip.is-active {
    background: var(--terracotta);
    border-color: var(--terracotta-deep);
    color: #fff;
  }

  .secondary-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }

  .switch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    user-select: none;
  }
  .switch-text { display: inline-flex; align-items: center; gap: 0.35em; }
  .switch-text .icon-star { color: var(--gold); fill: currentColor; stroke: none; width: 1.1em; height: 1.1em; }
  .switch input { position: absolute; opacity: 0; width: 0; height: 0; }
  .switch-track {
    width: 46px; height: 26px;
    border-radius: 999px;
    background: var(--paper-3);
    border: 2px solid var(--ink);
    position: relative;
    transition: background var(--t-med) var(--ease);
    flex: none;
  }
  .switch-knob {
    position: absolute;
    top: 2px; left: 2px;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: var(--ink);
    transition: transform var(--t-med) var(--ease), background var(--t-med) var(--ease);
  }
  .switch input:checked + .switch-track { background: var(--gold); }
  .switch input:checked + .switch-track .switch-knob { transform: translateX(20px); background: #fff; }
  .switch input:focus-visible + .switch-track { outline: 3px solid var(--pine); outline-offset: 2px; }

  .bypass {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--pine-deep);
    cursor: pointer;
    white-space: nowrap;
    user-select: none;
  }
  .bypass input { width: 20px; height: 20px; accent-color: var(--pine); cursor: pointer; }

  .btn-reset {
    font-size: 0.78rem;
    font-weight: 600;
    background: none;
    border: none;
    color: var(--terracotta);
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
    padding: 6px 4px;
    min-height: 36px;
    margin-left: auto;
  }
  .btn-reset:hover { color: var(--terracotta-deep); }

  .search { position: relative; }
  .search-icon {
    position: absolute;
    left: 13px; top: 50%;
    transform: translateY(-50%);
    width: 17px; height: 17px;
    color: var(--ink-soft);
    pointer-events: none;
  }
  .search input {
    width: 100%;
    font: inherit;
    font-family: var(--font-serif);
    font-size: 0.94rem;
    padding: 10px 14px 10px 38px;
    min-height: 44px;
    border: 2px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    transition: border-color var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease);
  }
  .search input::placeholder { color: var(--ink-soft); opacity: 0.8; }
  .search input:focus-visible { outline: none; border-color: var(--pine); box-shadow: var(--ring); }

  /* ---- Desktop: show everything inline, no toggle ---- */
  @media (min-width: 880px) {
    .filters-toggle { display: none; }
    .view-toggle { display: none; }
    .secondary,
    .secondary.is-open {
      display: grid;
      animation: none;
      background: var(--paper);
      border: 2px solid var(--ink);
      border-radius: var(--radius);
      padding: 13px;
      box-shadow: 3px 3px 0 rgba(42, 32, 23, 0.12);
    }
    .bar-row { order: 3; }
  }
</style>
