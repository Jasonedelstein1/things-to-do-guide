---
import { RATING_COLORS, RATING_GRADIENT } from '../lib/ratings.js';

const { title = "Andrea & Jason's Wedding — What To Do Guide", description = "An interactive map-and-list guide to things to do, see, and eat around Lyons, Colorado — filtered by the one-and-only Andrea↔Jason intensity scale." } = Astro.props;

// Expose the rating ramp to CSS as custom properties (kept in one place).
const rampVars = Object.entries(RATING_COLORS)
  .map(([k, v]) => `--r${k}: ${v};`)
  .join(' ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2f5d50" />
    <title>{title}</title>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.svg" />
    <meta name="twitter:card" content="summary_large_image" />

    <style set:html={`:root { ${rampVars} --rating-gradient: ${RATING_GRADIENT}; }`}></style>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Warm Colorado-Front-Range palette */
    --cream: #faf6ef;
    --paper: #ffffff;
    --paper-2: #fdfbf7;
    --ink: #2c2a26;
    --ink-soft: #6b6258;
    --line: #e8dfd2;
    --line-strong: #d9cdb9;
    --pine: #2f5d50;
    --pine-deep: #234a40;
    --terracotta: #c2643f;
    --gold: #d99100;
    --beyond: #7a6f9b;
    --shadow: 0 1px 2px rgba(44, 42, 38, 0.06), 0 6px 18px rgba(44, 42, 38, 0.08);
    --shadow-lg: 0 10px 40px rgba(44, 42, 38, 0.16);
    --radius: 14px;
    --radius-sm: 10px;
    --maxw: 1280px;
    --header-h: 0px;

    --font-serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Palatino, Georgia, "Times New Roman", serif;
    --font-sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  * { box-sizing: border-box; }

  html { -webkit-text-size-adjust: 100%; }

  body {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--ink);
    background: var(--cream);
    line-height: 1.55;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1, h2, h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink);
    margin: 0 0 0.35em;
  }

  a { color: var(--pine); }

  .wrap {
    width: 100%;
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 16px;
  }

  /* Visually-hidden but screen-reader available */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }

  /* Focus visibility for keyboard users */
  :focus-visible {
    outline: 3px solid var(--pine);
    outline-offset: 2px;
    border-radius: 6px;
  }

  /* ---------- Rating badge (used in cards & popups) ---------- */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.2em 0.6em;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.3;
    white-space: nowrap;
  }
  .badge .badge-num {
    background: rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    width: 1.45em;
    height: 1.45em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.86em;
  }
  .badge[data-rating="1"] { background: var(--r1); }
  .badge[data-rating="2"] { background: var(--r2); }
  .badge[data-rating="3"] { background: var(--r3); }
  .badge[data-rating="4"] { background: var(--r4); }
  .badge[data-rating="5"] { background: var(--r5); }
  .badge[data-rating="beyond"] { background: var(--beyond); }

  .badge-all-access {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.2em 0.6em;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--pine-deep);
    background: #e4efe7;
    border: 1px solid #c7e0cf;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
