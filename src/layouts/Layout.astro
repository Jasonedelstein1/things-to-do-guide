---
import { RATING_COLORS, RATING_GRADIENT } from '../lib/ratings.js';

const { title = "Andrea & Jason's Wedding — What To Do Guide", description = "An interactive map-and-list guide to things to do, see, and eat around Lyons, Colorado — filtered by the one-and-only Andrea↔Jason intensity scale." } = Astro.props;

// Expose the rating ramp to CSS as custom properties (kept in one place).
const rampVars = Object.entries(RATING_COLORS)
  .map(([k, v]) => `--r${k}: ${v};`)
  .join(' ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#244a3b" />
    <title>{title}</title>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Vintage trail-guide type pairing: Oswald (condensed display, headings,
         labels, badges, buttons — UPPERCASE) + Bitter (warm slab-serif body). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Bitter:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
    />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.svg" />
    <meta name="twitter:card" content="summary_large_image" />

    <style set:html={`:root { ${rampVars} --rating-gradient: ${RATING_GRADIENT}; }`}></style>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* === VINTAGE TRAIL-GUIDE / WPA NATIONAL-PARK PALETTE ===
       Warm printed-paper field-guide aesthetic. Rating ramp (--r1..--r5,
       --beyond, --rating-gradient) is set separately in <head> from
       ratings.js — the single source of truth — and must keep green→red. */

    /* Aged kraft paper */
    --cream: #efe3cf;        /* page background */
    --paper: #fbf6ea;        /* primary card/surface */
    --paper-2: #f6eedd;      /* secondary surface */
    --paper-3: #ecdfc6;      /* sunken / wells */

    /* Printed ink */
    --ink: #2a2017;          /* deep warm charcoal-brown (primary text) */
    --ink-soft: #6b5d49;     /* softer secondary — AA on kraft */
    --line: #d8c7a8;         /* hairline rules */
    --line-strong: #b9a37e;  /* sturdy borders */

    /* Field-guide accents */
    --pine: #244a3b;         /* forest green (primary) */
    --pine-deep: #1c3a2e;    /* deep forest */
    --terracotta: #bf5a3c;   /* clay (accent 1) */
    --terracotta-deep: #9d4429;
    --gold: #cb9433;         /* mustard / gold (accent 2) */
    --gold-deep: #a9761f;
    --sky: #5c8aa6;          /* dusty sky-blue (small accents) */
    --beyond: #6f6492;       /* "Other"/null seal */

    /* Links use forest green in this earthy scheme */
    --accent: #1c3a2e;
    --accent-deep: #244a3b;

    /* Letterpress-style elevation (warm, slightly harder edges) */
    --shadow-xs: 0 1px 0 rgba(42, 32, 23, 0.10);
    --shadow-sm: 0 1px 2px rgba(42, 32, 23, 0.10), 0 2px 5px rgba(42, 32, 23, 0.08);
    --shadow: 0 2px 4px rgba(42, 32, 23, 0.10), 0 6px 16px rgba(42, 32, 23, 0.12);
    --shadow-md: 0 3px 6px rgba(42, 32, 23, 0.12), 0 12px 30px rgba(42, 32, 23, 0.16);
    --shadow-lg: 0 8px 20px rgba(42, 32, 23, 0.16), 0 20px 52px rgba(42, 32, 23, 0.24);
    --ring: 0 0 0 3px rgba(36, 74, 59, 0.28);

    /* Stamps/passes read flatter — modest radii */
    --radius: 10px;
    --radius-sm: 7px;
    --radius-xs: 5px;
    --maxw: 1280px;
    --header-h: 0px;

    /* Motion tokens (150-250ms) */
    --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    --t-fast: 150ms;
    --t-med: 220ms;

    /* Type stacks */
    --font-display: "Oswald", "Oswald Fallback", "Arial Narrow", Impact, "Helvetica Neue", sans-serif;
    --font-serif: "Bitter", "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif;
    --font-sans: "Bitter", "Iowan Old Style", Georgia, "Times New Roman", serif;
  }

  * { box-sizing: border-box; }

  html { -webkit-text-size-adjust: 100%; }

  body {
    margin: 0;
    font-family: var(--font-serif);
    color: var(--ink);
    background-color: var(--cream);
    /* Subtle printed-paper speckle so the kraft reads "pressed", not flat. */
    background-image:
      radial-gradient(rgba(42, 32, 23, 0.030) 1px, transparent 1.4px),
      radial-gradient(rgba(42, 32, 23, 0.022) 1px, transparent 1.4px);
    background-size: 22px 22px, 22px 22px;
    background-position: 0 0, 11px 11px;
    line-height: 1.62;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  /* Headings are condensed Oswald, UPPERCASE with positive tracking —
     the WPA "trail sign" voice. */
  h1, h2, h3 {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.06;
    color: var(--ink);
    margin: 0 0 0.35em;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  a { color: var(--accent); text-underline-offset: 2px; }
  a:hover { color: var(--terracotta); }

  /* Shared "eyebrow" label voice — condensed, spaced caps */
  .eyebrow,
  .meta-cat,
  .end,
  .vbtn,
  .chip,
  .filters-toggle,
  .results-count,
  .slider-label,
  .scale-table th,
  .lg-item {
    font-family: var(--font-display);
  }

  /* Reusable inline-SVG icon convention (Lucide/Heroicons style).
     Icons inherit color via currentColor and align to the text baseline. */
  .icon {
    width: 1.05em;
    height: 1.05em;
    flex: none;
    display: inline-block;
    vertical-align: -0.16em;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }

  .wrap {
    width: 100%;
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 16px;
  }

  /* Visually-hidden but screen-reader available */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }

  /* Focus visibility for keyboard users — bold dashed "trail-blaze" ring */
  :focus-visible {
    outline: 3px solid var(--pine);
    outline-offset: 2px;
    border-radius: 4px;
  }
  /* Pointer affordance on everything interactive */
  button, summary, [role="button"], label.bypass, label.switch,
  a[href], input[type="range"], input[type="checkbox"] {
    cursor: pointer;
  }

  /* ---------- Rating SEAL / park-pass stamp ----------
     A round medallion: the rating numeral inside a colored disc with a
     thin inner ring, like a national-park entry stamp. Used consistently
     on cards, the slider readout, the scale table, and map popups.
     `.badge` is the seal; an optional label sibling sits beside it. */
  .badge {
    --seal: var(--beyond);
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink);
    line-height: 1.1;
    white-space: nowrap;
  }
  /* The circular seal itself (the numeral chip) */
  .badge .badge-num {
    position: relative;
    flex: none;
    width: 2.1em;
    height: 2.1em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--seal);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05em;
    line-height: 1;
    /* Dark halo keeps the white numeral legible even on the lighter
       (amber/light-green) rating-ramp seals — the ramp colors themselves
       are not changed (kept from ratings.js). */
    text-shadow: 0 1px 1px rgba(42, 32, 23, 0.6), 0 0 2px rgba(42, 32, 23, 0.55);
    /* Thin printed ring + sturdy outer edge */
    box-shadow:
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.9),
      inset 0 0 0 3px var(--seal),
      0 0 0 1.5px rgba(42, 32, 23, 0.45);
  }
  /* Seal with no separate label (e.g. table cell, slider chip) still shows ring */
  .badge[data-rating="1"] { --seal: var(--r1); }
  .badge[data-rating="2"] { --seal: var(--r2); }
  .badge[data-rating="3"] { --seal: var(--r3); }
  .badge[data-rating="4"] { --seal: var(--r4); }
  .badge[data-rating="5"] { --seal: var(--r5); }
  .badge[data-rating="beyond"] { --seal: var(--beyond); }
  /* "Other"/null seal: a small star/sparkle instead of a numeral */
  .badge[data-rating="beyond"] .badge-num svg {
    width: 1.1em; height: 1.1em; fill: #fff; stroke: none;
  }

  /* All-access "ranger" stamp — gold dashed ticket chip */
  .badge-all-access {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.28em 0.7em 0.24em;
    border-radius: var(--radius-xs);
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--gold-deep);
    background: rgba(203, 148, 51, 0.16);
    border: 1.5px dashed var(--gold);
    white-space: nowrap;
  }
  .badge-all-access .icon { stroke-width: 2; fill: currentColor; stroke: none; }

  /* ---------- Trail-sign section heading helper ---------- */
  /* A heavy Oswald banner with a route-marker chevron blaze + thick rule. */
  .blaze {
    flex: none;
    width: 0.9em;
    height: 0.9em;
    color: var(--terracotta);
    fill: currentColor;
    stroke: none;
  }

  /* Decorative double-rule / perforation helpers (aria-hidden in markup) */
  .perforation {
    height: 0;
    border: none;
    border-top: 2px dashed var(--line-strong);
    margin: 0;
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
