---
import Layout from '../layouts/Layout.astro';
import FilterBar from '../components/FilterBar.astro';
import PlaceCard from '../components/PlaceCard.astro';
import RmnpModal from '../components/RmnpModal.astro';
import MapView from '../components/MapView.astro';
import data from '../data/places.json';

const { meta, categories, places } = data;
const scale = meta.ratingScale;

// Section labels for the grouped list.
const catLabels = {
  'Attraction/Activity': 'Attractions & Activities',
  'Restaurant/Food': 'Food & Drink',
  'Itinerary Idea': 'Itinerary Ideas',
  'Other Activities': 'Other Activities',
};

// The RMNP explainer becomes a lightbox, not a normal card.
const rmnp = places.find((p) => p.id === 'rmnp-reservations');
const placesByCat = categories.map((cat) => ({
  cat,
  label: catLabels[cat] ?? cat,
  note: data.categoryNotes?.[cat] ?? null,
  items: places.filter((p) => p.category === cat && p.id !== 'rmnp-reservations'),
}));
---

<Layout title={meta.title}>
  <header class="site-header">
    <div class="wrap header-inner">
      <p class="eyebrow">
        <svg class="icon eyebrow-ring" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21.2l-7.4-7.4a4.7 4.7 0 0 1 6.6-6.7l.8.8.8-.8a4.7 4.7 0 0 1 6.6 6.7L12 21.2z"/></svg>
        We're getting married
      </p>
      <p class="hero-script" aria-hidden="true">Andrea &amp; Jason</p>
      <h1>Our <span class="hl">What&nbsp;To&nbsp;Do</span> Guide</h1>
      <p class="lede">
        These are our favorite things to do, see, and eat around our wedding venue —
        <strong>{meta.hub.name}</strong> in {meta.hub.town} — reaching out to Denver, Boulder,
        Longmont, Estes Park, Nederland, Grand Lake &amp; RMNP.
        Slide the <strong>Andrea&nbsp;↔&nbsp;Jason scale</strong> to match how much adventure you're up for —
        or just hit <strong>Show&nbsp;everything</strong> and browse it all.
      </p>

      <details class="scale-explainer">
        <summary>How the Andrea&nbsp;↔&nbsp;Jason scale works</summary>
        <p class="scale-note">{meta.scaleNote}</p>
        <table class="scale-table">
          <thead>
            <tr><th>Rating</th><th>Label</th><th>What it means</th></tr>
          </thead>
          <tbody>
            {Object.entries(scale).map(([num, s]) => (
              <tr>
                <td><span class="badge" data-rating={num}><span class="badge-num">{num}</span></span></td>
                <td class="st-label">{s.label}</td>
                <td>{s.meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>
    </div>
  </header>

  <div class="controls" id="controls">
    <div class="wrap">
      <FilterBar scale={scale} categories={categories} />
    </div>
  </div>

  <main class="wrap main">
    <div class="layout" id="layout" data-view="list">
      <section class="map-pane" aria-label="Map">
        <MapView />
      </section>

      <section class="list-pane" aria-label="List of places">
        <p class="empty-state" id="empty-state" hidden>
          Nothing matches those filters. Try nudging the slider toward Jason, or
          <button type="button" class="link-btn" id="empty-reset">reset the filters</button>.
        </p>

        {placesByCat.map((group) => (
          <section class="cat-section" data-cat={group.cat}>
            <h2 class="cat-heading">{group.label} <span class="cat-count">({group.items.length})</span></h2>
            {group.note && <p class="cat-note">{group.note}</p>}
            <div class="card-grid">
              {group.items.map((place) => <PlaceCard place={place} />)}
            </div>
          </section>
        ))}
      </section>
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>
        We made this with love for our wedding weekend — every note here is ours. The
        <em>verified</em> details are point-in-time, so <strong>please re-check hours, road &amp; trail
        status, and reservations before you go.</strong>
      </p>
      <p class="footer-fine">
        Map data © <a href="https://www.openstreetmap.org/copyright" rel="noopener" target="_blank">OpenStreetMap</a> contributors ·
        Built with Astro + Leaflet.
      </p>
    </div>
  </footer>

  <RmnpModal place={rmnp} />

  <!-- Data for the client island (parsed at runtime; no extra bundle weight). -->
  <script type="application/json" id="places-data" set:html={JSON.stringify(data)}></script>

  <script>
    import { ratingColor, searchText } from '../lib/ratings.js';

    const dataEl = document.getElementById('places-data');
    const data = JSON.parse(dataEl.textContent);
    const { meta, places } = data;
    const scale = meta.ratingScale;
    const hub = meta.hub;
    const byId = new Map(places.map((p) => [p.id, p]));
    const blobById = new Map(places.map((p) => [p.id, searchText(p)]));

    // ---- DOM refs ----
    const slider = document.getElementById('intensity');
    const readoutNum = document.getElementById('readout-num');
    const readoutLabel = document.getElementById('readout-label');
    const readoutBadge = document.getElementById('readout-badge');
    const readoutMeaning = document.getElementById('readout-meaning');
    const chips = Array.from(document.querySelectorAll('.chip'));
    const allAccessToggle = document.getElementById('allaccess-toggle');
    const search = document.getElementById('search');
    const resetBtn = document.getElementById('reset-filters');
    const emptyReset = document.getElementById('empty-reset');
    const countShown = document.getElementById('count-shown');
    const countTotal = document.getElementById('count-total');
    const emptyState = document.getElementById('empty-state');
    const controls = document.getElementById('controls');
    const layout = document.getElementById('layout');
    const vbtns = Array.from(document.querySelectorAll('.vbtn'));
    const bypassToggle = document.getElementById('bypass-toggle');
    const sliderBlock = document.querySelector('.slider-block');
    const modal = document.getElementById('rmnp-modal');
    const modalDialog = modal.querySelector('.modal');
    const mapModeEl = document.getElementById('map-mode');

    const cards = Array.from(document.querySelectorAll('.card'));
    const cardById = new Map(cards.map((c) => [c.dataset.id, c]));

    // ---- Filter state ----
    const state = { max: 5, category: 'all', allAccess: false, query: '', bypass: false };

    function passes(p) {
      if (!state.bypass && p.rating > state.max) return false;
      if (state.category !== 'all' && p.category !== state.category) return false;
      if (state.allAccess && !p.allAccess) return false;
      if (state.query && !blobById.get(p.id).includes(state.query)) return false;
      return true;
    }

    function applyFilters() {
      let shown = 0;
      for (const p of places) {
        if (p.id === 'rmnp-reservations') continue;
        const ok = passes(p);
        const card = cardById.get(p.id);
        if (card) {
          card.hidden = !ok;
          if (ok) shown++;
        }
        const m = markers.get(p.id);
        if (m && map) {
          if (ok && !mapLayer.hasLayer(m)) mapLayer.addLayer(m);
          else if (!ok && mapLayer.hasLayer(m)) mapLayer.removeLayer(m);
        }
      }
      document.querySelectorAll('.cat-section').forEach((sec) => {
        sec.hidden = !sec.querySelector('.card:not([hidden])');
      });
      countShown.textContent = String(shown);
      emptyState.hidden = shown !== 0;
    }

    // ---- Slider readout ----
    function updateReadout() {
      const v = state.max;
      const s = scale[String(v)];
      readoutNum.textContent = String(v);
      readoutLabel.textContent = s.label;
      readoutBadge.dataset.rating = String(v);
      slider.setAttribute('aria-valuetext', `${v} of 5 — ${s.label}`);
      sliderBlock.classList.toggle('is-bypassed', state.bypass);
      slider.disabled = state.bypass;
      readoutMeaning.textContent = state.bypass
        ? 'The scale is off — showing everything.'
        : s.meaning;
    }

    slider.addEventListener('input', () => {
      state.max = Number(slider.value);
      updateReadout();
      applyFilters();
    });

    bypassToggle.addEventListener('change', () => {
      state.bypass = bypassToggle.checked;
      updateReadout();
      applyFilters();
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        state.category = chip.dataset.category;
        chips.forEach((x) => {
          const active = x === chip;
          x.classList.toggle('is-active', active);
          x.setAttribute('aria-pressed', String(active));
        });
        applyFilters();
      });
    });

    allAccessToggle.addEventListener('change', () => {
      state.allAccess = allAccessToggle.checked;
      applyFilters();
    });

    let searchTimer;
    search.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        state.query = search.value.trim().toLowerCase();
        applyFilters();
      }, 110);
    });

    function resetFilters() {
      state.max = 5; state.category = 'all'; state.allAccess = false; state.query = ''; state.bypass = false;
      slider.value = '5';
      bypassToggle.checked = false;
      updateReadout();
      allAccessToggle.checked = false;
      search.value = '';
      chips.forEach((x) => {
        const active = x.dataset.category === 'all';
        x.classList.toggle('is-active', active);
        x.setAttribute('aria-pressed', String(active));
      });
      applyFilters();
    }
    resetBtn.addEventListener('click', resetFilters);
    emptyReset?.addEventListener('click', resetFilters);

    // ---- Mobile map/list view toggle ----
    function setView(view) {
      layout.dataset.view = view;
      vbtns.forEach((b) => {
        const active = b.dataset.view === view;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });
      if (view === 'map') ensureMap().then(() => map && map.invalidateSize());
    }
    vbtns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.view)));

    // ---- Leaflet map (lazy) ----
    let map = null;
    let mapLayer = null;
    let mapReady = false;
    let mapLoadingPromise = null;
    const markers = new Map();
    let activeId = null;
    let youAreHere = null;
    let accuracyCircle = null;

    function esc(s) {
      const d = document.createElement('div');
      d.textContent = s == null ? '' : String(s);
      return d.innerHTML;
    }

    // Inline-SVG icon strings (Lucide/Heroicons style) used inside Leaflet
    // markup, which is built as HTML strings rather than DOM nodes.
    const SVG = {
      sparkle: '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3l1.8 5.5L19.5 10l-5.7 1.5L12 17l-1.8-5.5L4.5 10l5.7-1.5L12 3z"/></svg>',
      heart: '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20.5l-7.2-7.2a4.6 4.6 0 0 1 6.5-6.5l.7.7.7-.7a4.6 4.6 0 0 1 6.5 6.5L12 20.5z"/></svg>',
      ring: '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21.2l-7.4-7.4a4.7 4.7 0 0 1 6.6-6.7l.8.8.8-.8a4.7 4.7 0 0 1 6.6 6.7L12 21.2z"/></svg>',
      ticket: '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2 2 2 0 0 0 0 4 2 2 0 0 1-2 2H6a2 2 0 0 1-2-2 2 2 0 0 0 0-4z"/><path d="M10 6v2"/><path d="M10 11v2"/><path d="M10 16v2"/></svg>',
      mountain: '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18L14.5 7l-3 5-2-3L3 20z"/><path d="M11.5 12l1-2"/></svg>',
      mountainSolid: '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 20h18L14.5 7l-3 5-2-3L3 20z"/></svg>',
      nav: '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5l9.5 19-9.5-4-9.5 4 9.5-19z"/></svg>',
      navSolid: '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5l9.5 19-9.5-4-9.5 4 9.5-19z"/></svg>',
      car: '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l1.6-4.2A2 2 0 0 1 8.5 7.5h7a2 2 0 0 1 1.9 1.3L19 13"/><path d="M3 17h18v-3.2a1.8 1.8 0 0 0-1-1.6l-1-.5H5l-1 .5a1.8 1.8 0 0 0-1 1.6V17z"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/></svg>',
      star: '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 18.2 6.1 21.3l1.2-6.6L2.5 9.5l6.6-.9L12 2.5z"/></svg>',
      check: '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>',
      mapStreet: '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"/><path d="M9 4v14"/><path d="M15 6v14"/></svg>',
    };

    function makeIcon(p, active = false) {
      const color = ratingColor(p.rating);
      const sym = p.rating == null ? SVG.sparkle : p.rating;
      return L.divIcon({
        className: 'map-pin' + (active ? ' is-active' : ''),
        html: `<div class="map-pin-inner" style="background:${color}"><span class="map-pin-num">${sym}</span></div>`,
        iconSize: [26, 26],
        iconAnchor: [13, 26],
        popupAnchor: [0, -26],
      });
    }
    function homeIcon() {
      return L.divIcon({
        className: 'map-pin map-pin-home',
        html: `<div class="map-pin-inner"><span class="map-pin-num">${SVG.heart}</span></div>`,
        iconSize: [30, 30],
        iconAnchor: [15, 30],
        popupAnchor: [0, -30],
      });
    }
    function youAreHereIcon() {
      return L.divIcon({
        className: 'you-are-here',
        html: '<span class="yah-dot"></span>',
        iconSize: [22, 22],
        iconAnchor: [11, 11],
        popupAnchor: [0, -12],
      });
    }
    function locateMe() {
      if (!map) return;
      if (!('geolocation' in navigator)) {
        window.alert('Location isn’t available on this device.');
        return;
      }
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const { latitude, longitude, accuracy } = pos.coords;
          const ll = [latitude, longitude];
          if (youAreHere) {
            youAreHere.setLatLng(ll);
            accuracyCircle.setLatLng(ll).setRadius(accuracy);
          } else {
            youAreHere = L.marker(ll, { icon: youAreHereIcon(), zIndexOffset: 2000 })
              .addTo(map)
              .bindPopup('<div class="pop"><p class="pop-name">You are here</p></div>');
            accuracyCircle = L.circle(ll, {
              radius: accuracy, color: '#1a73e8', weight: 1, fillColor: '#1a73e8', fillOpacity: 0.12,
            }).addTo(map);
          }
          map.setView(ll, Math.max(map.getZoom(), 13), { animate: true });
          youAreHere.openPopup();
        },
        () => {
          window.alert('Couldn’t get your location. Check that location access is allowed in your browser, then try again.');
        },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 }
      );
    }

    function popupHtml(p) {
      const beyond = p.rating == null;
      const color = ratingColor(p.rating);
      const ratingLabel = beyond
        ? `${SVG.sparkle} Other`
        : `${p.rating} · ${esc(scale[String(p.rating)].label)}`;
      let aka = '';
      if (p.nickname) aka = `aka "${esc(p.nickname)}"`;
      else if (p.formerName) aka = `formerly "${esc(p.formerName)}"`;

      const linksToRmnp = p.reservation && /timed-entry/i.test(p.reservation) && /RMNP/i.test(p.reservation);
      let resHtml = '';
      if (p.reservation) {
        resHtml = `<div class="pop-res${linksToRmnp ? ' is-rmnp' : ''}">${SVG.ticket} <strong>Reservation:</strong> ${esc(p.reservation)}` +
          (linksToRmnp ? ` <button type="button" class="pop-rmnp-flag" data-open-rmnp>${SVG.mountainSolid} RMNP permit info</button>` : '') + `</div>`;
      }

      let dualHtml = '';
      if (p.ratingJason) {
        dualHtml = `<p class="pop-dual">Drive it: Andrea (${p.rating}) · Ride it: Jason (${p.ratingJason})</p>`;
      } else if (p.ratingRange) {
        dualHtml = `<p class="pop-dual">Spans ${p.ratingRange[0]}–${p.ratingRange[1]} · filtered at ${p.rating}</p>`;
      }

      const notes = (p.notes || []).map((n) => `<li>${esc(n)}</li>`).join('');
      const verified = p.verified ? `<p class="pop-verified">${SVG.check} ${esc(p.verified)}</p>` : '';
      const drive = p.driveFromLyons ? ` · ${SVG.car} ${esc(p.driveFromLyons)}` : '';
      const dir = `https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lng}&travelmode=driving`;

      return `
        <div class="pop">
          <p class="pop-name">${esc(p.name)}</p>
          ${aka ? `<p class="pop-aka">${aka}</p>` : ''}
          <span class="pop-badge" style="background:${color}">${ratingLabel}</span>
          ${p.allAccess ? ` <span class="pop-badge" style="background:#3f7a5b">${SVG.star} All-access</span>` : ''}
          <p class="pop-meta">${esc(p.town)}${drive}</p>
          ${resHtml}
          ${dualHtml}
          <ul class="pop-notes">${notes}</ul>
          ${verified}
          <div class="pop-actions">
            <a class="pop-dir" href="${dir}" target="_blank" rel="noopener noreferrer">${SVG.navSolid} Directions</a>
            <a class="pop-link" href="#card-${p.id}" data-show-list="${p.id}">See in list ↓</a>
          </div>
        </div>`;
    }

    function loadLeaflet() {
      return new Promise((resolve, reject) => {
        if (window.L) return resolve(window.L);
        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        document.head.appendChild(css);
        const js = document.createElement('script');
        js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        js.onload = () => resolve(window.L);
        js.onerror = () => reject(new Error('Leaflet failed to load'));
        document.head.appendChild(js);
      });
    }

    function initMap() {
      map = L.map('map', { scrollWheelZoom: true, zoomControl: true, maxZoom: 18 }).setView([hub.lat, hub.lng], 10);

      const osmAttr = '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors';
      const osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: osmAttr });
      const topoLayer = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
        maxNativeZoom: 17,
        maxZoom: 18,
        attribution: osmAttr + ' · SRTM | © <a href="https://opentopomap.org">OpenTopoMap</a> (CC-BY-SA)',
      });
      osmLayer.addTo(map);

      // Auto-swap to a topographic basemap when zoomed in — great over trailheads.
      let baseMode = 'osm';
      function updateBase() {
        const z = map.getZoom();
        if (z >= 13 && baseMode !== 'topo') {
          map.removeLayer(osmLayer); topoLayer.addTo(map); baseMode = 'topo';
        } else if (z < 13 && baseMode !== 'osm') {
          map.removeLayer(topoLayer); osmLayer.addTo(map); baseMode = 'osm';
        }
        if (mapModeEl) mapModeEl.innerHTML = baseMode === 'topo' ? `${SVG.mountainSolid} Topo` : `${SVG.mapStreet} Street`;
      }
      map.on('zoomend', updateBase);

      mapLayer = L.layerGroup().addTo(map);

      // Distinct home marker for the wedding venue.
      L.marker([hub.lat, hub.lng], { icon: homeIcon(), zIndexOffset: 1000, keyboard: false })
        .bindPopup(`<div class="pop"><p class="pop-name">${SVG.ring} ${esc(hub.name)}</p><p class="pop-meta">The wedding — ${esc(hub.town || '')}</p></div>`)
        .addTo(map);

      // "Show my location" control.
      const LocateControl = L.Control.extend({
        options: { position: 'topleft' },
        onAdd() {
          const btn = L.DomUtil.create('button', 'map-locate-btn');
          btn.type = 'button';
          btn.title = 'Show my location';
          btn.setAttribute('aria-label', 'Show my location');
          btn.innerHTML = SVG.navSolid;
          L.DomEvent.on(btn, 'click', (ev) => { L.DomEvent.stop(ev); locateMe(); });
          return btn;
        },
      });
      map.addControl(new LocateControl());

      const pts = [[hub.lat, hub.lng]];
      for (const p of places) {
        if (p.lat == null || p.lng == null) continue;
        const m = L.marker([p.lat, p.lng], { icon: makeIcon(p), title: p.name });
        m.bindPopup(() => popupHtml(p), { maxWidth: 300, minWidth: 220 });
        m.on('popupopen', () => { setActivePin(p.id); flashCard(p.id); });
        // A genuine click on the pin scrolls the list to its card (desktop:
        // both panes are visible; mobile keeps the popup so we don't yank away).
        m.on('click', () => { if (isDesktop()) scrollToCard(p.id); });
        markers.set(p.id, m);
        pts.push([p.lat, p.lng]);
      }

      map.fitBounds(L.latLngBounds(pts).pad(0.12));
      applyFilters();
      setTimeout(() => map.invalidateSize(), 60);
    }

    function ensureMap() {
      if (mapReady) return Promise.resolve();
      if (mapLoadingPromise) return mapLoadingPromise;
      mapLoadingPromise = loadLeaflet()
        .then(() => { initMap(); mapReady = true; })
        .catch((err) => {
          console.error(err);
          const ph = document.getElementById('map-placeholder');
          if (ph) ph.innerHTML = '<p>Map couldn’t load. Check your connection — the list below still works.</p>';
        });
      return mapLoadingPromise;
    }

    function setActivePin(id) {
      activeId = id;
      for (const [pid, m] of markers) {
        m.setIcon(makeIcon(byId.get(pid), pid === id));
      }
    }

    function flashCard(id) {
      const card = cardById.get(id);
      if (!card) return;
      card.classList.add('is-flash');
      setTimeout(() => card.classList.remove('is-flash'), 1600);
    }

    function isDesktop() {
      return window.matchMedia('(min-width: 880px)').matches;
    }

    function scrollToCard(id) {
      const card = cardById.get(id);
      if (!card || card.hidden) return;
      if (!isDesktop()) setView('list');
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      card.focus({ preventScroll: true });
      flashCard(id);
    }

    function focusMarker(id) {
      const m = markers.get(id);
      const p = byId.get(id);
      if (!m || !map || !p) return;
      if (!mapLayer.hasLayer(m)) mapLayer.addLayer(m);
      map.setView([p.lat, p.lng], Math.max(map.getZoom(), 12), { animate: true });
      m.openPopup();
      setActivePin(id);
      setTimeout(() => map.invalidateSize(), 60);
    }

    // Delegated clicks for cross-component actions.
    document.addEventListener('click', async (e) => {
      const showMap = e.target.closest('[data-show-map]');
      if (showMap) {
        const id = showMap.getAttribute('data-show-map');
        if (!isDesktop()) setView('map');
        await ensureMap();
        focusMarker(id);
        return;
      }
      const showList = e.target.closest('[data-show-list]');
      if (showList) {
        e.preventDefault();
        scrollToCard(showList.getAttribute('data-show-list'));
        return;
      }
      const openR = e.target.closest('[data-open-rmnp]');
      if (openR) {
        e.preventDefault();
        openModal();
        return;
      }
      const closeR = e.target.closest('[data-close-modal]');
      if (closeR) {
        e.preventDefault();
        closeModal();
      }
    });

    // ---- RMNP permit lightbox ----
    let lastFocused = null;
    function focusables() {
      return Array.from(
        modalDialog.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
      ).filter((el) => el.offsetParent !== null);
    }
    function openModal() {
      if (!modal.hidden) return;
      lastFocused = document.activeElement;
      modal.hidden = false;
      document.body.classList.add('modal-open');
      modalDialog.focus();
    }
    function closeModal() {
      if (modal.hidden) return;
      modal.hidden = true;
      document.body.classList.remove('modal-open');
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }
    // Close on backdrop click (but not when clicking inside the dialog).
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (modal.hidden) return;
      if (e.key === 'Escape') { closeModal(); return; }
      if (e.key === 'Tab') {
        const f = focusables();
        if (!f.length) return;
        const first = f[0];
        const last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    // ---- Collapsible "Filters" panel (mobile; always open on desktop via CSS) ----
    const filtersToggle = document.getElementById('filters-toggle');
    const secondaryPanel = document.getElementById('secondary');
    filtersToggle?.addEventListener('click', () => {
      const open = secondaryPanel.classList.toggle('is-open');
      filtersToggle.setAttribute('aria-expanded', String(open));
      setHeaderH();
    });

    // Keep --header-h in sync with the sticky controls height.
    function setHeaderH() {
      document.documentElement.style.setProperty('--header-h', controls.offsetHeight + 'px');
    }
    window.addEventListener('resize', setHeaderH);

    // ---- Init ----
    countTotal.textContent = String(cards.length);
    updateReadout();
    applyFilters();
    setHeaderH();

    // Lazy-load the map when it scrolls into view (fires immediately on desktop).
    const io = new IntersectionObserver((entries) => {
      if (entries.some((en) => en.isIntersecting)) {
        io.disconnect();
        ensureMap();
      }
    }, { rootMargin: '250px' });
    io.observe(document.getElementById('map'));
  </script>

