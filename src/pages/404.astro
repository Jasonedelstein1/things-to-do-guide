---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lost the trail — Andrea & Jason's Wedding Guide">
  <main class="notfound wrap">
    <p class="nf-emoji" aria-hidden="true">🥾</p>
    <h1>It's 10 more miles than the sign said.</h1>
    <p>That page wandered off into the Indian Peaks. (A very Jason move.)</p>
    <p><a class="nf-home" href="/">← Back to the What To Do Guide</a></p>
  </main>
</Layout>

<style>
  .notfound {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
    padding: 40px 16px;
  }
  .nf-emoji { font-size: 3rem; margin: 0; }
  .notfound h1 { font-size: clamp(1.6rem, 5vw, 2.4rem); }
  .nf-home {
    display: inline-block;
    margin-top: 12px;
    font-weight: 700;
    background: var(--pine);
    color: #fff;
    padding: 10px 18px;
    border-radius: 999px;
    text-decoration: none;
  }
</style>
