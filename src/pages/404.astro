---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lost the trail — Andrea & Jason's Wedding Guide">
  <main class="notfound wrap">
    <p class="nf-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 4h3l.4 6.2c.1 1 .7 1.8 1.6 2.2l5.1 2.4a3 3 0 0 1 1.7 2.7V20H5V4z"/>
        <path d="M5 16h13"/>
        <path d="M9 11.5l2.2 1"/>
        <path d="M9.5 8l1.8.9"/>
      </svg>
    </p>
    <h1>It's 10 more miles than the sign said.</h1>
    <p>That page wandered off into the Indian Peaks. (A very Jason move.)</p>
    <p><a class="nf-home" href="/">← Back to the What To Do Guide</a></p>
  </main>
</Layout>

<style>
  .notfound {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
    padding: 40px 16px;
  }
  .nf-icon { margin: 0; color: var(--terracotta); }
  .nf-icon svg { width: 64px; height: 64px; }
  .notfound h1 { font-size: clamp(1.6rem, 5vw, 2.4rem); }
  .nf-home {
    display: inline-block;
    margin-top: 12px;
    font-weight: 700;
    background: var(--pine);
    color: #fff;
    padding: 11px 20px;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: background var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease),
                transform var(--t-fast) var(--ease);
  }
  .nf-home:hover { background: var(--pine-deep); color: #fff; box-shadow: var(--shadow-md); }
  .nf-home:active { transform: translateY(1px); }
</style>
